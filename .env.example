# ─────────────────────────────────────────────────────────────
# Lozinka za /admin (istorija rezultata).
# Ako je ne postavis, koristi se podrazumevana: CrveniKrstMionica18
# ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=CrveniKrstMionica18

# Tajni kljuc kojim se potpisuju runde i admin kolacic.
# Napravi nasumican niz znakova (npr. `openssl rand -base64 32`).
QUIZ_SECRET=promeni-me-u-nasumican-niz-znakova

# Postgres baza. Na Vercelu: Storage -> Neon -> Connect Project,
# i Vercel ovo sam ubaci. Lokalno mozes da ostavis prazno —
# tada se rezultati cuvaju u .data/quiz.json
# DATABASE_URL=postgresql://...
